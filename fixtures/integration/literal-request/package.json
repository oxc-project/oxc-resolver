{
  "name": "literal-request",
  "imports": {
    "#choice?raw": { "import": "./package.json", "require": "./index.cjs" },
    "#plain": "./index.cjs",
    "#star/*": "./*"
  },
  "exports": {
    "./item?*": { "import": "./package.json", "require": "./index.cjs" },
    "./plain": "./index.cjs",
    "./star/*": "./*",
    "./target?*": "./index.cjs?mode=*#entry"
  }
}
